# Copy to .env and fill in. Never commit .env.

# --- Bright Data residential proxy (leave all three unset for direct connection) ---
BRD_CUSTOMER=            # e.g. hl_a1b2c3d4 (dashboard → account settings)
BRD_ZONE=                # your residential zone name, e.g. residential_proxy1
BRD_PASSWORD=            # the zone password

# --- ntfy alerts ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=              # pick something unguessable, e.g. shop-monitor-x7k2m9
NTFY_TOKEN=              # only for protected topics / self-hosted ntfy

# --- browser takeover ---
VNC_PASSWORD=            # required; protects every noVNC session
LIVE_VIEW_URL=http://localhost:6080/vnc.html   # single-instance compose only; the fleet builds per-instance URLs from MINI_HOST

# --- fleet (docker-compose.fleet.yml, generated by gen-fleet.js) ---
MINI_HOST=               # hostname phones/laptops reach the mini by — its Tailscale MagicDNS name
FLEET_BIND=127.0.0.1     # interface published ports bind to; set to the mini's Tailscale IP (tailscale ip -4)
DASHBOARD_PORT=7300      # dashboard's published port (7000 clashes with macOS AirPlay Receiver)
QUEUE_SIZE=1000            # queue depth; each instance starts at a random position 1..QUEUE_SIZE
                           # and admits (flips to form) after ~position seconds. Mean ~QUEUE_SIZE/2 s.

# --- single-instance test site flip window (legacy docker-compose.yml only) ---
FLIP_MIN_SECONDS=60
FLIP_MAX_SECONDS=600
