# Copy to .env and fill in. Never commit .env.

# --- Bright Data residential proxy (leave all three unset for direct connection) ---
BRD_CUSTOMER=            # e.g. hl_a1b2c3d4 (dashboard → account settings)
BRD_ZONE=                # your residential zone name, e.g. residential_proxy1
BRD_PASSWORD=            # the zone password

# --- ntfy alerts ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=              # pick something unguessable, e.g. shop-monitor-x7k2m9
NTFY_TOKEN=              # only for protected topics / self-hosted ntfy

# --- browser takeover ---
VNC_PASSWORD=            # required; protects the noVNC session
LIVE_VIEW_URL=http://localhost:6080/vnc.html   # the link embedded in alerts — use your VPS hostname in production

# --- test site flip window (seconds after start/reset) ---
FLIP_MIN_SECONDS=60
FLIP_MAX_SECONDS=600
